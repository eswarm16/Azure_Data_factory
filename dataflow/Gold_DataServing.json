{
	"name": "Gold_DataServing",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "ls_datalake",
						"type": "LinkedServiceReference"
					},
					"name": "CarDetails"
				},
				{
					"linkedService": {
						"referenceName": "ls_datalake",
						"type": "LinkedServiceReference"
					},
					"name": "CarSalesDetails"
				},
				{
					"linkedService": {
						"referenceName": "ls_datalake",
						"type": "LinkedServiceReference"
					},
					"name": "StudentNames"
				},
				{
					"linkedService": {
						"referenceName": "ls_datalake",
						"type": "LinkedServiceReference"
					},
					"name": "StudentMarks"
				},
				{
					"linkedService": {
						"referenceName": "ls_datalake",
						"type": "LinkedServiceReference"
					},
					"name": "GradeTable"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "ls_datalake",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				},
				{
					"linkedService": {
						"referenceName": "ls_datalake",
						"type": "LinkedServiceReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "Innerjoin"
				},
				{
					"name": "select"
				},
				{
					"name": "Leftjoin"
				},
				{
					"name": "selectGradeTable"
				},
				{
					"name": "join1"
				},
				{
					"name": "window1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "select1"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "derivedSellDate"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "sort1"
				},
				{
					"name": "alterRow2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          VIN as string,",
				"          Make as string,",
				"          Model as string,",
				"          Year as integer,",
				"          Variant as string,",
				"          Body as string,",
				"          Color as string,",
				"          Fuel_Type as string,",
				"          Transmission as string,",
				"          Engine_CC as integer,",
				"          Price as integer,",
				"          Updated_at as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'car_details') ~> CarDetails",
				"source(output(",
				"          VIN as string,",
				"          Name as string,",
				"          Gender as string,",
				"          Age as integer,",
				"          City as string,",
				"          State as string,",
				"          Loan as string,",
				"          Sell_Date as date,",
				"          Updated_at as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'car_sales_details') ~> CarSalesDetails",
				"source(output(",
				"          Id as short,",
				"          First_Name as string,",
				"          Last_Name as string,",
				"          Full_Name as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'student_names') ~> StudentNames",
				"source(output(",
				"          Student_Id as short,",
				"          Subject as string,",
				"          Marks as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'student_marks') ~> StudentMarks",
				"source(output(",
				"          Grade as string,",
				"          Marks as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'grades_table') ~> GradeTable",
				"CarDetails, CarSalesDetails join(CarDetails@VIN == CarSalesDetails@VIN,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> Innerjoin",
				"Innerjoin select(mapColumn(",
				"          Make,",
				"          Model,",
				"          Transmission,",
				"          State,",
				"          Price,",
				"          Sell_Date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select",
				"StudentNames, StudentMarks join(Id == Student_Id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> Leftjoin",
				"GradeTable select(mapColumn(",
				"          Grade,",
				"          Marks_Limit = Marks",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectGradeTable",
				"Leftjoin, selectGradeTable join(Marks>=Marks_Limit,",
				"     joinType:'cross',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 window(over(Id,",
				"          Subject),",
				"     desc(Marks, false),",
				"     rn = rowNumber()) ~> window1",
				"window1 filter(rn == 1) ~> filter1",
				"filter1 select(mapColumn(",
				"          Id,",
				"          Name = Full_Name,",
				"          Subject,",
				"          Marks,",
				"          Grade",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 alterRow(upsertIf(1==1)) ~> alterRow1",
				"select derive(Sell_Years = year(Sell_Date)) ~> derivedSellDate",
				"derivedSellDate aggregate(groupBy(Make,",
				"          Model,",
				"          Transmission,",
				"          State,",
				"          Sell_Years),",
				"     Quantity_Sold = count(1),",
				"          Sales = sum(Price)) ~> aggregate1",
				"aggregate1 sort(asc(Make, false),",
				"     asc(Model, false),",
				"     asc(Transmission, false),",
				"     asc(State, false),",
				"     desc(Sell_Years, false),",
				"     desc(Quantity_Sold, false),",
				"     desc(Sales, false)) ~> sort1",
				"sort1 alterRow(upsertIf(1==1)) ~> alterRow2",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'gold',",
				"     folderPath: 'student_grades',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['Id'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1",
				"alterRow2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'gold',",
				"     folderPath: 'car_sales',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['Make','Model','Transmission','State','Sell_Years'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink2"
			]
		}
	}
}