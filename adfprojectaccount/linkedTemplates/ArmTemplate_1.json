{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfprojectaccount"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/SQL_to_Datalake')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "GetSQLTables",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT\n    t.TABLE_SCHEMA AS table_schema,\n    t.TABLE_NAME AS table_name,\n    c.COLUMN_NAME AS watermark_column\nFROM INFORMATION_SCHEMA.TABLES t\nJOIN INFORMATION_SCHEMA.COLUMNS c\nON t.TABLE_NAME = c.TABLE_NAME\nAND t.TABLE_SCHEMA = c.TABLE_SCHEMA\nWHERE t.TABLE_TYPE = 'BASE TABLE'\nAND c.COLUMN_NAME IN (\n    'Updated_at'\n)",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_sql_scr",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ForEachTable",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "GetSQLTables",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('GetSQLTables').output.value",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "LastLoad",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "JsonSource",
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": true,
												"enablePartitionDiscovery": false
											},
											"formatSettings": {
												"type": "JsonReadSettings"
											}
										},
										"dataset": {
											"referenceName": "ds_lastload_json",
											"type": "DatasetReference",
											"parameters": {}
										},
										"firstRowOnly": false
									}
								},
								{
									"name": "Copy_SQL_Data",
									"type": "Copy",
									"dependsOn": [
										{
											"activity": "LastLoad",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@concat(\n'SELECT * FROM [',\nitem().table_schema,\n'].[',\nitem().table_name,\n'] WHERE [',\nitem().watermark_column,\n'] > ''',\nactivity('LastLoad').output.value[0].lastload,\n''''\n)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "ds_sql_scr",
											"type": "DatasetReference",
											"parameters": {}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_datalake_bronze_sql_Parquet",
											"type": "DatasetReference",
											"parameters": {
												"file_name": {
													"value": "@concat(item().table_name,'.parquet')",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "CurrentTime",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Copy_SQL_Data",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "Current_time",
										"value": {
											"value": "@formatDateTime(utcNow(),'yyyy-MM-dd HH:mm:ss.fff')",
											"type": "Expression"
										}
									}
								},
								{
									"name": "Update_LastLoad",
									"type": "Copy",
									"dependsOn": [
										{
											"activity": "CurrentTime",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "JsonSource",
											"additionalColumns": [
												{
													"name": "lastload",
													"value": {
														"value": "@variables('Current_time')",
														"type": "Expression"
													}
												}
											],
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": true,
												"enablePartitionDiscovery": false
											},
											"formatSettings": {
												"type": "JsonReadSettings"
											}
										},
										"sink": {
											"type": "JsonSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "JsonWriteSettings"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "ds_empty_json",
											"type": "DatasetReference",
											"parameters": {}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_lastload_json",
											"type": "DatasetReference",
											"parameters": {}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"Current_time": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_onprem')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_onprem_file",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "FileServerLocation"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_onprem_dynamic')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_onprem_file",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"file_name": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "FileServerLocation",
						"fileName": {
							"value": "@dataset().file_name",
							"type": "Expression"
						}
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Silver_DataTransformation')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_student_names",
								"type": "DatasetReference"
							},
							"name": "studentnames"
						},
						{
							"dataset": {
								"referenceName": "ds_student_marks",
								"type": "DatasetReference"
							},
							"name": "studentmarks"
						},
						{
							"dataset": {
								"referenceName": "ds_student_grades",
								"type": "DatasetReference"
							},
							"name": "studentgrades"
						},
						{
							"dataset": {
								"referenceName": "ds_car_details",
								"type": "DatasetReference"
							},
							"name": "cardetails"
						},
						{
							"dataset": {
								"referenceName": "ds_car_sales_details",
								"type": "DatasetReference"
							},
							"name": "carsalesdetails"
						}
					],
					"sinks": [
						{
							"linkedService": {
								"referenceName": "ls_datalake",
								"type": "LinkedServiceReference"
							},
							"name": "sinkstudentnames"
						},
						{
							"linkedService": {
								"referenceName": "ls_datalake",
								"type": "LinkedServiceReference"
							},
							"name": "sinkstudentmarks"
						},
						{
							"linkedService": {
								"referenceName": "ls_datalake",
								"type": "LinkedServiceReference"
							},
							"name": "sinkgrades"
						},
						{
							"linkedService": {
								"referenceName": "ls_datalake",
								"type": "LinkedServiceReference"
							},
							"name": "sinkcardetails"
						},
						{
							"linkedService": {
								"referenceName": "ls_datalake",
								"type": "LinkedServiceReference"
							},
							"name": "sinkcarsalesdetails"
						}
					],
					"transformations": [
						{
							"name": "derivedUpperCase"
						},
						{
							"name": "derivedFullname"
						},
						{
							"name": "sortMarks"
						},
						{
							"name": "derivedGrade"
						},
						{
							"name": "castPrice"
						},
						{
							"name": "derivedUpperCases"
						},
						{
							"name": "derivedColumnUpper"
						},
						{
							"name": "alterRow1"
						},
						{
							"name": "alterRow2"
						},
						{
							"name": "alterRow3"
						},
						{
							"name": "alterRow4"
						},
						{
							"name": "alterRow5"
						},
						{
							"name": "derivedUpper"
						},
						{
							"name": "select"
						}
					],
					"scriptLines": [
						"source(output(",
						"          Id as short,",
						"          First_Name as string,",
						"          Last_Name as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> studentnames",
						"source(output(",
						"          Student_Id as short,",
						"          Subject as string,",
						"          Marks as short",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> studentmarks",
						"source(output(",
						"          Grade as string,",
						"          Marks as short",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     documentForm: 'documentPerLine') ~> studentgrades",
						"source(output(",
						"          VIN as string,",
						"          Make as string,",
						"          Model as string,",
						"          Year as integer,",
						"          Variant as string,",
						"          Body as string,",
						"          Color as string,",
						"          Fuel_Type as string,",
						"          Transmission as string,",
						"          Engine_CC as integer,",
						"          Price as decimal(7,2),",
						"          Updated_at as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet') ~> cardetails",
						"source(output(",
						"          VIN as string,",
						"          Buyer_Name as string,",
						"          Buyer_Gender as string,",
						"          Buyer_Age as integer,",
						"          Buyer_City as string,",
						"          Buyer_State as string,",
						"          Loan_Taken as string,",
						"          Sell_Date as date,",
						"          Dealer_Name as string,",
						"          Updated_at as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet') ~> carsalesdetails",
						"studentnames derive(First_Name = upper(First_Name),",
						"          Last_Name = upper(Last_Name)) ~> derivedUpperCase",
						"derivedUpperCase derive(Full_Name = concat(First_Name,\" \",Last_Name)) ~> derivedFullname",
						"studentmarks sort(desc(Marks, false)) ~> sortMarks",
						"studentgrades derive(Grade = replace(Grade,'F','FAIL')) ~> derivedGrade",
						"cardetails cast(output(",
						"          Price as integer",
						"     ),",
						"     errors: true) ~> castPrice",
						"castPrice derive(VIN = upper(VIN),",
						"          Make = upper(Make),",
						"          Model = upper(Model),",
						"          Variant = upper(Variant),",
						"          Body = upper(Body),",
						"          Color = upper(Color),",
						"          Fuel_Type = upper(Fuel_Type),",
						"          Transmission = upper(Transmission)) ~> derivedUpperCases",
						"carsalesdetails derive(VIN = upper(VIN),",
						"          Buyer_Name = upper(Buyer_Name),",
						"          Buyer_Gender = upper(Buyer_Gender),",
						"          Buyer_City = upper(Buyer_City),",
						"          Buyer_State = upper(Buyer_State),",
						"          Loan_Taken = upper(Loan_Taken)) ~> derivedColumnUpper",
						"derivedFullname alterRow(upsertIf(1==1)) ~> alterRow1",
						"derivedUpper alterRow(upsertIf(1==1)) ~> alterRow2",
						"derivedGrade alterRow(upsertIf(1==1)) ~> alterRow3",
						"derivedUpperCases alterRow(upsertIf(1==1)) ~> alterRow4",
						"select alterRow(upsertIf(1==1)) ~> alterRow5",
						"sortMarks derive(Subject = upper(Subject)) ~> derivedUpper",
						"derivedColumnUpper select(mapColumn(",
						"          VIN,",
						"          Name = Buyer_Name,",
						"          Gender = Buyer_Gender,",
						"          Age = Buyer_Age,",
						"          City = Buyer_City,",
						"          State = Buyer_State,",
						"          Loan = Loan_Taken,",
						"          Sell_Date,",
						"          Updated_at",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select",
						"alterRow1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'delta',",
						"     fileSystem: 'silver',",
						"     folderPath: 'student_names',",
						"     mergeSchema: false,",
						"     autoCompact: false,",
						"     optimizedWrite: false,",
						"     vacuum: 0,",
						"     deletable: false,",
						"     insertable: false,",
						"     updateable: false,",
						"     upsertable: true,",
						"     keys:['Id'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sinkstudentnames",
						"alterRow2 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'delta',",
						"     fileSystem: 'silver',",
						"     folderPath: 'student_marks',",
						"     mergeSchema: false,",
						"     autoCompact: false,",
						"     optimizedWrite: false,",
						"     vacuum: 0,",
						"     deletable: false,",
						"     insertable: false,",
						"     updateable: false,",
						"     upsertable: true,",
						"     keys:['Student_Id','Subject'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sinkstudentmarks",
						"alterRow3 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'delta',",
						"     fileSystem: 'silver',",
						"     folderPath: 'grades_table',",
						"     mergeSchema: false,",
						"     autoCompact: false,",
						"     optimizedWrite: false,",
						"     vacuum: 0,",
						"     deletable: false,",
						"     insertable: true,",
						"     updateable: false,",
						"     upsertable: true,",
						"     keys:['Marks'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sinkgrades",
						"alterRow4 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'delta',",
						"     fileSystem: 'silver',",
						"     folderPath: 'car_details',",
						"     mergeSchema: false,",
						"     autoCompact: false,",
						"     optimizedWrite: false,",
						"     vacuum: 0,",
						"     deletable: false,",
						"     insertable: true,",
						"     updateable: false,",
						"     upsertable: true,",
						"     keys:['VIN'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sinkcardetails",
						"alterRow5 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'delta',",
						"     fileSystem: 'silver',",
						"     folderPath: 'car_sales_details',",
						"     mergeSchema: false,",
						"     autoCompact: false,",
						"     optimizedWrite: false,",
						"     vacuum: 0,",
						"     deletable: false,",
						"     insertable: true,",
						"     updateable: false,",
						"     upsertable: true,",
						"     keys:['VIN'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sinkcarsalesdetails"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/Silver_Transformations')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "SilverDataFlow",
